{
  "name": "nudge-mind",
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "main": "src/app/index.js",
  "compatibility_date": "2026-09-19",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "nudge_mind_db",
      "database_name": "nudge-mind-db",
      "database_id": "REPLACE_WITH_NEW_D1_DATABASE_ID",
      "migrations_dir": "store/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "nudge_mind_sessions",
      "id": "REPLACE_WITH_NEW_KV_NAMESPACE_ID"
    }
  ],
  "assets": {
    "directory": "../view/dist",
    "binding": "ASSETS"
  },
  "vars": {
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-chat",
    "AI_TEMPERATURE": "0.5",
    "AI_CONTEXT_SUMMARY_THRESHOLD": "10000",
    "AI_CONTEXT_RECENT_CHARS": "4000"
  }
}
