{
  "name": "nudge-mind-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:view": "npm --prefix ../view run build",
    "deploy": "npm run build:view && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nudge-mind-db --local",
    "db:seed:local": "wrangler d1 execute nudge-mind-db --local --file=store/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply nudge-mind-db --remote",
    "db:seed:remote": "wrangler d1 execute nudge-mind-db --remote --file=store/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
